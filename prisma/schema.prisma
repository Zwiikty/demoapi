datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int       @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String    @unique
  phone         String
  password      String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resetToken    String?
  resetTokenExp DateTime?
  bookings      Booking[]
  points        Int       @default(0)
  pointLedger   PointLedger[]
  deviceTokens DeviceToken[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model Court {
  id           Int       @id @default(autoincrement())
  name         String
  location     String
  pricePerHour Float
  bookings     Booking[]
  timeSlots    CourtTimeSlot[]
  walkInBooking WalkInBooking[]
}

model Booking {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id])
  userId    Int
  court     Court         @relation(fields: [courtId], references: [id])
  courtId   Int
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(PENDING)
  slipImage String?
  createAt  DateTime      @default(now())
  updateAt  DateTime      @updatedAt
  rescheduledFromId Int?
  rescheduledFrom Booking? @relation("RescheduleRelation", fields: [rescheduledFromId], references: [id])
  rescheduledTo Booking[] @relation("RescheduleRelation")
  BookingChangeLog BookingChangeLog[]
  paymentSlipAmount Float?
  paymentVerified Boolean @default(false)
  paymentConfirmedAt  DateTime?
  bookingTimeSlots BookingTimeSlot[]
  notiBeforeUse Int?
  remindedAt    DateTime?
  pointLedger PointLedger?

  @@index([startTime])
  @@index([userId])
  @@index([remindedAt])
}

enum BookingStatus {
  PENDING
  APPROVE
  REJECTED
}

model CourtTimeSlot {
  id  Int @id @default(autoincrement())
  court Court @relation(fields: [courtId], references: [id])
  courtId Int
  startTime DateTime
  endTime DateTime
  status     SlotStatus @default(AVAILABLE)
  bookingTimeSlots BookingTimeSlot[]
}

enum SlotStatus {
  AVAILABLE
  UNAVAILABLE
  BOOKED
  MAINTENANCE
}

model BookingChangeLog {
  id  Int @id @default(autoincrement())
  booking Booking @relation(fields: [bookingId], references: [id])
  bookingId Int
  changedAt DateTime @default(now())
}

model BookingTimeSlot {
  id             Int             @id @default(autoincrement())
  booking        Booking?         @relation(fields: [bookingId], references: [id])
  bookingId      Int?
  courtTimeSlot  CourtTimeSlot   @relation(fields: [courtTimeSlotId], references: [id])
  courtTimeSlotId Int
  walkInBooking WalkInBooking?    @relation(fields: [walkInBookingId], references: [id])
  walkInBookingId Int?
  @@unique([bookingId, courtTimeSlotId])
}

model WalkInBooking {
  id         Int           @id @default(autoincrement())
  court      Court         @relation(fields: [courtId], references: [id])
  courtId    Int
  date       DateTime
  startTime  DateTime
  endTime    DateTime
  fullName   String
  people     Int
  status     WalkInStatus @default(APPROVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  bookingTimeSlots BookingTimeSlot[]
}

enum WalkInStatus {
  APPROVE
  CANCEL
}

model PointLedger {
  id               Int       @id @default(autoincrement())
  user             User      @relation(fields: [userId], references: [id])
  userId           Int
  booking          Booking?  @relation(fields: [bookingId], references: [id])
  bookingId        Int?      @unique
  points           Int
  reason           String?
  createdAt        DateTime  @default(now())
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String   // 'android' | 'ios' | 'web'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
}